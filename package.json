{
  "name": "dayweave-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "A calm, always-visible desktop planner.",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron-vite dev --watch",
    "dev:desktop": "node scripts/dev-launcher.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "preview:ui": "vite --config vite.ui-preview.config.ts",
    "typecheck": "tsc --noEmit",
    "dist:win": "node scripts/prepare-release.cjs && npm run typecheck && npm run build && electron-builder --win --x64 --publish never",
    "pack:win": "node scripts/prepare-release.cjs && npm run typecheck && npm run build && electron-builder --win --x64 --dir --publish never",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:imports-ui": "npm run build && electron scripts/verify-calendar-imports.cjs",
    "dist:mac": "node scripts/prepare-release.cjs && npm run typecheck && npm run build && electron-builder --mac zip --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.468.0",
    "node-ical": "^0.27.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "productName": "Dayweave",
  "author": "Dayweave",
  "dependencies": {
    "koffi": "3.3.7"
  }
}
