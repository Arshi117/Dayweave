{
  "name": "dayweave-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, always-visible desktop planner.",
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist:win": "node scripts/prepare-release.cjs && npm run typecheck && npm run build && electron-builder --win --x64 --publish never",
    "pack:win": "node scripts/prepare-release.cjs && npm run typecheck && npm run build && electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.468.0",
    "node-ical": "^0.27.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "productName": "Dayweave",
  "author": "Dayweave"
}
